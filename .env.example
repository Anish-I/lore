# Lore needs NO environment configuration for normal local use — the desktop app
# runs SQLite + an embedded vector store out of the box.
#
# The variables below are only for the OPT-IN server-parity/dev lanes:

# Server mode (deployed team server or the docker-compose dev lane):
#DATABASE_URL=postgresql://vault:vault@localhost:5433/vault
#QDRANT_URL=http://localhost:6333

# Optional hosted embeddings/rerank (defaults to fully-local models when unset):
#VOYAGE_API_KEY=

# Backend port override (default 8099):
#LORE_PORT=8099

# Optional enterprise Okta SSO. Use an Okta Native Application with Authorization
# Code + PKCE and client authentication set to None (no desktop client secret).
#OKTA_ISSUER=https://example.okta.com/oauth2/default
#OKTA_CLIENT_ID=
#OKTA_SCOPES=openid email profile groups
#OKTA_GROUP_SCOPE_MAP={"Engineering":"team-engineering"}
#
# Confidential clients are supported when required by an existing integration:
#OKTA_CLIENT_SECRET=
#OKTA_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
